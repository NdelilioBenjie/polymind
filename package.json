{
  "name": "polymind",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "One prompt, every model. A multi-model AI workspace as a web app and a Chrome side panel.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev -w @polymind/web",
    "build": "npm run build -w @polymind/web",
    "build:extension": "npm run build -w @polymind/extension",
    "build:all": "npm run build && npm run build:extension",
    "preview": "npm run preview -w @polymind/web",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@netlify/edge-functions": "^4.0.4",
    "@types/chrome": "^0.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.9"
  }
}
