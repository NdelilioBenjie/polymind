# Server-side settings. Set these in Netlify (Site configuration > Environment variables)
# and in a local .env file for development. Never commit real keys.

# Your OpenRouter key. Without it Polymind runs in demo mode with simulated answers.
OPENROUTER_API_KEY=

# "free" (default) lets visitors use only zero-cost models. "all" unlocks every model
# and bills your OpenRouter credits, so pair it with a spending limit on the key.
POLYMIND_MODEL_ACCESS=free

# Upper bound on tokens a single answer may generate.
POLYMIND_MAX_OUTPUT_TOKENS=2048

# Optional, comma-separated extra origins allowed to call the API from a browser.
POLYMIND_ALLOWED_ORIGINS=

# Netlify injects its own OpenRouter credentials (billed to your Netlify credits) when
# no key is set. Polymind ignores them and stays in demo mode unless this is "true".
POLYMIND_USE_NETLIFY_GATEWAY=false
